{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"useTabs": true,
	"semi": true,
	"trailingComma": "all",
	"sortImports": {
		"enabled": true
	},
	"sortTailwindcss": {
		"enabled": true
	},
	"ignorePatterns": ["node_modules/**", "build/**", "dist/**", ".wrangler/**", ".react-router/**"]
}
