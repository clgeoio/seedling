{
	"name": "{{projectName}}",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "react-router build",
		"preview": "wrangler dev",
		"deploy": "wrangler deploy",
		"deploy:version": "wrangler versions upload",
		"deploy:promote": "wrangler versions deploy",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:drop": "drizzle-kit drop",
		"db:seed:local": "tsx drizzle/seed/seed.ts",
		"db:seed:remote": "wrangler d1 execute DB --remote --file=drizzle/seed/seed.sql",
		"db:studio": "drizzle-kit studio",
		"db:reset:local": "wrangler d1 execute DB --local --command='SELECT name FROM sqlite_master WHERE type=\"table\"' && wrangler d1 migrations apply DB --local",
		"db:delete:local": "rm -rf .wrangler/state",
		"auth:secret": "openssl rand -base64 32",
		"auth:generate": "npx @better-auth/cli generate --config app/services/auth/auth.server.ts --output drizzle/schema/auth.ts"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.1.0",
		"@radix-ui/react-checkbox": "^1.1.0",
		"@radix-ui/react-dialog": "^1.1.0",
		"@radix-ui/react-dropdown-menu": "^2.1.0",
		"@radix-ui/react-label": "^2.1.0",
		"@radix-ui/react-select": "^2.1.0",
		"@radix-ui/react-separator": "^1.1.0",
		"@radix-ui/react-slot": "^1.1.0",
		"@radix-ui/react-tabs": "^1.1.0",
		"@react-router/cloudflare": "^7.5.0",
		"better-auth": "^1.2.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.0",
		"drizzle-orm": "^0.41.0",
		"isbot": "^5.1.0",
		"lucide-react": "^0.500.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.5.0",
		"resend": "^4.0.0",
		"sonner": "^2.0.0",
		"tailwind-merge": "^3.0.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.0",
		"better-sqlite3": "^12.0.0",
		"@cloudflare/workers-types": "^4.0.0",
		"@cloudflare/vite-plugin": "^1.0.0",
		"@commitlint/cli": "^19.0.0",
		"@commitlint/config-conventional": "^19.0.0",
		"@react-router/dev": "^7.5.0",
		"@tailwindcss/vite": "^4.1.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"drizzle-kit": "^0.31.0",
		"lefthook": "^1.11.0",
		"oxfmt": "^0.1.0",
		"oxlint": "^1.0.0",
		"tailwindcss": "^4.1.0",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"vite": "^6.3.0",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-tsconfig-paths": "^4.3.0",
		"wrangler": "^4.14.0"
	}
}
